<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme. -->
    <style name="Theme.CultureSync" parent="Theme.Material3.Dark.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorOnPrimary">@color/text_primary</item>
        <item name="colorPrimaryContainer">@color/brand_surface</item>
        <item name="colorOnPrimaryContainer">@color/text_primary</item>

        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/brand_secondary</item>
        <item name="colorOnSecondary">@color/brand_deep</item>

        <!-- Tertiary brand color (Accent). -->
        <item name="colorTertiary">@color/brand_accent</item>
        <item name="colorOnTertiary">@color/brand_deep</item>

        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/brand_deep</item>
        <item name="android:windowBackground">@color/brand_deep</item>
        
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
