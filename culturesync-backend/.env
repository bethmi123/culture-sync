# =============================================================
#  HOW TO USE:
#  1. Replace every placeholder value below with your real values
#  2. NEVER commit this file to Git (.gitignore already excludes it)
#  3. For production (Railway/Render), set these as env vars in
#     the platform dashboard instead of using this file
# =============================================================


# -------------------------------------------------------------
# MongoDB Atlas Connection
# -------------------------------------------------------------
# Get this from: MongoDB Atlas → Your Cluster → Connect →
#   Drivers → Copy the connection string
# Replace <username>, <password>, and <cluster-url> with yours
# -------------------------------------------------------------
MONGODB_URI=mongodb+srv://bethmij_db_user:wzwtz3nqJ5zgjbxO@cluster0.errl6f8.mongodb.net/culturesync?retryWrites=true&w=majority&appName=Cluster0


# -------------------------------------------------------------
# Server Port
# -------------------------------------------------------------
# The port your Node.js Express server listens on locally.
# On Railway/Render this is set automatically — leave as 3000.
# -------------------------------------------------------------
PORT=3000


# -------------------------------------------------------------
# Node Environment
# -------------------------------------------------------------
# Use "development" locally, "production" on deployed server
# -------------------------------------------------------------
NODE_ENV=development


# -------------------------------------------------------------
# CORS Origin (optional — tighten for production)
# -------------------------------------------------------------
# In development allow all origins (*).
# In production, replace * with your deployed API domain.
# -------------------------------------------------------------
CORS_ORIGIN=*


# -------------------------------------------------------------
# Android App BASE_URL (for your reference only — not used by
# the server itself; update RetrofitClient.kt with this URL)
# -------------------------------------------------------------
# Local (same WiFi network):  http://YOUR_PC_IP:3000/
# Production (Railway):       https://your-app-name.up.railway.app/
# Production (Render):        https://your-app-name.onrender.com/
# -------------------------------------------------------------
# ANDROID_BASE_URL=http://192.168.1.20:3000/
